{
  "manifest_version": 3,
  "name": "Email Ledger",
  "version": "0.1.1",
  "description": "记录邮箱的使用状态、付费状态，以及从 Claude 注册当天算起的天数。",
  "action": {
    "default_title": "Email Ledger",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "key": ""
}
